{
  "mcpServers": {
    "manifest-eval": {
      "command": "python",
      "args": [
        "-m",
        "eval.mcp_server"
      ],
      "env": {
        "MCP_SERVER_URL": "http://localhost:4444",
        "MCP_AUTH": "see ~/.bob/settings/mcp.json for the bearer token — never commit credentials here"
      },
      "disabled": false,
      "alwaysAllow": []
    }
  }
}
