# Manifest local env template.
# Copy to .env (gitignored) and fill values later. Never commit .env.
# Production: same names in Vercel project settings (Khadim 1.18).
# GitHub Actions secrets: same four names on StephenSook/manifest (corpus-build.yml).
# Placeholder names only. Empty values. No VAPID (web push 2.11 is cut).

# IBM watsonx.ai (task 0.13 live 200s, production /api/ask Granite + Guardian)
# Get the key from IBM Cloud: Manage, Access (IAM), API keys.
# Get the project UUID from the watsonx.ai project details page.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Region of that project. Expected: us-south unless created elsewhere.
# Endpoint is https://<region>.ml.cloud.ibm.com
WATSONX_REGION=

# Vercel Blob (corpus-build.yml upload, production /api/ask cold-start fetch)
# Provision in Vercel: Storage, Blob. Token from vercel blob or the dashboard.
BLOB_READ_WRITE_TOKEN=

# Not an app secret. Set as a GitHub Actions repo VARIABLE (not a secret)
# after Khadim 1.17: Settings, Secrets and variables, Actions, Variables.
# Example: https://manifest-web-roan.vercel.app  (no trailing slash)
# Required by .github/workflows/uptime.yml. The job fails if unset (no skip).
# MANIFEST_DEPLOY_URL=
